<odoo>
    <data noupdate="1">
        <!-- Tự động check-in nhân viên -->
        <record id="ir_cron_auto_check_in" model="ir.cron">
            <field name="name">Auto Check-In Employees</field>
            <field name="model_id" ref="model_cham_cong"/>
            <field name="state">code</field>
            <field name="code">model.auto_check_in()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Tự động check-out nhân viên -->
        <record id="ir_cron_auto_check_out" model="ir.cron">
            <field name="name">Auto Check-Out Employees</field>
            <field name="model_id" ref="model_cham_cong"/>
            <field name="state">code</field>
            <field name="code">model.auto_check_out()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
